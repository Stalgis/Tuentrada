# Auth endpoint (POST /login). Must be HTTPS in production.
EXPO_PUBLIC_API_URL=

# Reports/data API base URL (no trailing slash). Must be HTTPS in production.
EXPO_PUBLIC_BASE_URL=

# Public client identifier sent as x-api-key header.
# NOTE: this value is bundled into the client binary by Expo and is not a secret.
# It is a soft gate for unauthenticated traffic; do not rely on it for authorization.
EXPO_PUBLIC_API_KEY=

# Sentry DSN for error tracking (optional — leave empty to disable).
# Get this from sentry.io → your project → Settings → Client Keys.
EXPO_PUBLIC_SENTRY_DSN=

# Agent service URL. On a physical device use your computer's LAN IP.
# Example: http://192.168.1.20:8787
EXPO_PUBLIC_AGENT_API_URL=

# OpenAI credentials are server-only. Never prefix these values with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-terra

# Local agent service.
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8787
AGENT_ALLOWED_ORIGIN=*

# Server-side report configuration. During local development the service falls
# back to EXPO_PUBLIC_BASE_URL and EXPO_PUBLIC_API_KEY when these are empty.
REPORT_API_BASE_URL=
REPORT_API_KEY=

# ─── Agent service limits ─────────────────────────────────────────────────────
# Total budget for one chat request. The upstream timeout must be smaller, so
# authenticating cannot consume the whole budget (the service refuses to start
# otherwise).
# The upstream timeout matches the app's own client (src/lib/reportApi.ts, 20s).
# With a shorter one the agent failed on /history over large accounts exactly
# where the app succeeds.
AGENT_REQUEST_TIMEOUT_MS=35000
REPORT_API_TIMEOUT_MS=20000

# Shared per-session catalog cache. There is no cheap session-validation
# endpoint, so every message would otherwise refetch the full event list.
# TRADEOFF: while an entry lives, a revoked session still passes validation.
# Set to 0 to disable the cache and revalidate on every message.
AGENT_CATALOG_CACHE_TTL_MS=60000

# Conversation history, kept in the service process memory.
AGENT_CONVERSATION_TTL_MS=1800000
AGENT_CONVERSATION_MAX_ITEMS=40

# Spend and abuse limits. The daily token budget is the one that protects you
# from your own bug (a tool loop, a prompt that grows unbounded). Set to 0 to
# disable it — not recommended while the service is reachable by real users.
AGENT_DAILY_TOKEN_BUDGET=1000000

# How many times the model may speak in one chat request. Each turn can trigger
# a tool call. A compound question ("how am I doing this month and how do people
# pay?") needs three or four.
AGENT_MAX_TURNS=6

# Hard ceiling on backend calls per chat request. Each tool has its own limit,
# but that is per call: without this, a multi-turn run could chain twelve
# availability lookups several times over. This is the real cost ceiling of one
# question. Repeated identical lookups are memoized and do not count.
AGENT_MAX_UPSTREAM_CALLS=25
# Global pre-auth ceiling. It prevents rotating random Bearer tokens from
# bypassing the per-session limit and flooding the reports backend.
AGENT_GLOBAL_RATE_LIMIT_MAX=1000
AGENT_RATE_LIMIT_MAX=30
AGENT_RATE_LIMIT_WINDOW_MS=3600000
AGENT_MAX_CONCURRENT=4

# Returns the agent's tool calls in the HTTP response. Debugging only: the
# service refuses to start with this enabled and NODE_ENV=production. Tool
# calls are always written to the server log regardless of this flag.
AGENT_EXPOSE_TOOL_CALLS=false
