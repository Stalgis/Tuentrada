# Auth endpoint (POST /login). Must be HTTPS in production.
EXPO_PUBLIC_API_URL=

# Reports/data API base URL (no trailing slash). Must be HTTPS in production.
EXPO_PUBLIC_BASE_URL=

# Public client identifier sent as x-api-key header.
# NOTE: this value is bundled into the client binary by Expo and is not a secret.
# It is a soft gate for unauthenticated traffic; do not rely on it for authorization.
EXPO_PUBLIC_API_KEY=

# Sentry DSN for error tracking (optional — leave empty to disable).
# Get this from sentry.io → your project → Settings → Client Keys.
EXPO_PUBLIC_SENTRY_DSN=

# OpenAI credentials are server-only. Never prefix these values with EXPO_PUBLIC_.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.6-terra

# Local agent service. Replace the demo token with real auth before production.
AGENT_SERVICE_HOST=127.0.0.1
AGENT_SERVICE_PORT=8787
AGENT_DEMO_TOKEN=change-me-local-only
