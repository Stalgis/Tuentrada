{
  "cli": {
    "version": ">= 18.11.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "testflight": {
      "extends": "production",
      "distribution": "store",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_AGENT_API_URL": "https://tuentrada-agent.onrender.com"
      }
    }
  },
  "submit": {
    "production": {},
    "testflight": {
      "extends": "production"
    }
  }
}
